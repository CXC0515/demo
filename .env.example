# Server-only OpenAI-compatible multimodal configuration.
# Keep the key on the API server and never expose it as a VITE_* variable.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_VISION_MODEL=""
OPENAI_REMINDER_MODEL="gpt-5.6-luna"

# PaddleOCR parses PDF/image materials through the official API. DOCX parsing
# uses the local PaddleOCR doc2md command from an isolated Python environment.
PADDLEOCR_ACCESS_TOKEN=""
PADDLEOCR_BASE_URL=""
PADDLEOCR_MODEL="PaddleOCR-VL-1.6"
PADDLEOCR_COMMAND="paddleocr"
PADDLEOCR_PYTHON="python3"

# Public URL used for self-referential links and callbacks when deployed.
APP_URL="MY_APP_URL"
# Generate a unique value of at least 32 characters. Never reuse an AI/API key.
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# Production runtime. Keep APP_DATA_ROOT outside the Git worktree so upgrades
# and worktree cleanup cannot remove SQLite databases or uploaded files.
NODE_ENV="development"
API_HOST="127.0.0.1"
API_PORT="3001"
APP_DATA_ROOT="var"
APP_BACKUP_ROOT="var/backups"
APP_DIST_DIR="dist"
SHUTDOWN_TIMEOUT_MS="15000"

# Optional legacy/script overrides. Authenticated HTTP requests always resolve
# business databases from workspaces/<workspace-id>/data.
ROSTER_DB_PATH=""
RESOURCE_DB_PATH=""
ROSTER_BACKUP_DIR=""
